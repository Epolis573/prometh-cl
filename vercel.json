{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "functions": {
    "api/render.js": { "includeFiles": "views/**/*.ejs" }
  },
  "rewrites": [
    { "src": "^/$", "dest": "/api/render" },
    { "src": "^/(navigations|assets|images|css|js|public)/.*", "dest": "/api/index.js" },
    { "src": "^/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
