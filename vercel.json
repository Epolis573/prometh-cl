{
  "version": 2,
  "builds": [
    { "src": "api/render.js", "use": "@vercel/node" },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/api/render" },         
    { "src": "/api/(.*)", "dest": "/api/index.js" }, 
    { "src": "/(.*)", "dest": "/public/$1" }         
  ]
}
