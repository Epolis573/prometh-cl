{
  "version": 2,
  "builds": [
    { "src": "api/render.js", "use": "@vercel/node", "config": { "includeFiles": "views/**/*.ejs" } },
    { "src": "api/index.js",  "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/api/render" },
    { "src": "^/(navigations|assets|images|css|js|public)/.*", "dest": "/api/index.js" },
    { "src": "^/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
