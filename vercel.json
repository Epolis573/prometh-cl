{
  "version": 2,
  "functions": {
    "api/index.js": { "runtime": "nodejs@20.x" },
    "api/render.js": {
      "runtime": "nodejs@20.x",
      "includeFiles": "views/**/*.ejs"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/render" },
    { "src": "^/(navigations|assets|images|css|js|public)/.*", "dest": "/api/index.js" },
    { "src": "^/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
